{
  "name": "permly",
  "version": "0.1.0",
  "description": "Simple, type-safe roles & permissions for Node.js. Works with MySQL, Postgres and MongoDB.",
  "keywords": [
    "permissions",
    "roles",
    "rbac",
    "acl",
    "authorization",
    "access-control",
    "spatie",
    "laravel-permission",
    "express",
    "middleware",
    "mysql",
    "mariadb",
    "postgres",
    "postgresql",
    "mongodb",
    "mongoose",
    "typescript"
  ],
  "homepage": "https://github.com/PJPhukan/permly#readme",
  "bugs": {
    "url": "https://github.com/PJPhukan/permly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PJPhukan/permly.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PJPhukan"
  },
  "license": "MIT",
  "author": "Paragjyoti Phukan",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "permly": "dist/cli.js"
  },
  "typesVersions": {
    "*": {
      "memory": [
        "./dist/memory.d.ts"
      ],
      "mysql": [
        "./dist/mysql.d.ts"
      ],
      "express": [
        "./dist/express.d.ts"
      ],
      "postgres": [
        "./dist/postgres.d.ts"
      ],
      "mongodb": [
        "./dist/mongodb.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.ts",
        "default": "./dist/memory.js"
      },
      "require": {
        "types": "./dist/memory.d.cts",
        "default": "./dist/memory.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql.d.ts",
        "default": "./dist/mysql.js"
      },
      "require": {
        "types": "./dist/mysql.d.cts",
        "default": "./dist/mysql.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./mongodb": {
      "import": {
        "types": "./dist/mongodb.d.ts",
        "default": "./dist/mongodb.js"
      },
      "require": {
        "types": "./dist/mongodb.d.cts",
        "default": "./dist/mongodb.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:ci": "PERMLY_REQUIRE_DB=1 vitest run",
    "examples:test": "npm run build && node scripts/examples-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "express": ">=4.17.0",
    "mongodb": ">=6.0.0",
    "mongoose": ">=8.0.0",
    "mysql2": ">=3.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "express4": "npm:express@^4.22.3",
    "express5": "npm:express@^5.2.1",
    "globals": "^17.12.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
